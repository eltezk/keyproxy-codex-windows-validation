#!/usr/bin/env python3
"""Choose a KeyProxy model dynamically and launch Claude Code."""

import argparse
import json
import os
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

FALLBACK_MODELS = [
    "auto", "gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna", "gpt-5.5",
    "gpt-5.4", "gpt-5.4-mini", "gpt-5.3-codex", "gpt-5.3-codex-xhigh",
    "gpt-5.3-codex-high", "gpt-5.3-codex-low", "gpt-5.3-codex-none",
]
VALIDATED_MODELS = {
    "gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna", "gpt-5.5", "gpt-5.4",
    "gpt-5.4-mini",
}


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def read_settings(config_dir):
    path = config_dir / "settings.json"
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise SystemExit(f"Não foi possível ler {path}: {exc}")
    if not isinstance(data, dict):
        raise SystemExit(f"{path} não contém um objeto JSON")
    return data


def cache_write(path, models):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump({"models": models}, stream)
            stream.write("\n")
        os.chmod(name, 0o600)
        os.replace(name, path)
        os.chmod(path, 0o600)
    except Exception:
        try:
            os.unlink(name)
        except FileNotFoundError:
            pass


def cache_read(path, allowed):
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        models = data.get("models", [])
        return [item for item in models if isinstance(item, str) and item in allowed]
    except (OSError, ValueError, AttributeError):
        return []


def endpoint(models_url):
    parsed = urllib.parse.urlsplit(models_url)
    if parsed.scheme != "https" or not parsed.netloc:
        raise ValueError("KEYPROXY_MODELS_URL precisa ser HTTPS")
    query = parsed.query or "limit=1000"
    return urllib.parse.urlunsplit((parsed.scheme, parsed.netloc, parsed.path, query, ""))


def discover(models_url, token, allowed):
    url = endpoint(models_url)
    request = urllib.request.Request(
        url,
        headers={"Authorization": f"Bearer {token}", "Accept": "application/json"},
    )
    opener = urllib.request.build_opener(NoRedirect())
    with opener.open(request, timeout=3) as response:
        if response.status != 200:
            raise ValueError(f"HTTP {response.status}")
        payload = json.loads(response.read(1024 * 1024))
    rows = payload.get("data", []) if isinstance(payload, dict) else []
    models = []
    for row in rows:
        model = row.get("id") if isinstance(row, dict) else None
        capabilities = row.get("capabilities") if isinstance(row, dict) else None
        tool_capable = not isinstance(capabilities, dict) or capabilities.get("toolCalling") is True
        if (
            isinstance(model, str)
            and model != "auto"
            and tool_capable
            and model in allowed
            and model not in models
        ):
            models.append(model)
    if not models:
        raise ValueError("a API não retornou modelos autorizados")
    return models


def choose(models):
    if not sys.stdin.isatty():
        raise SystemExit("Use --model <id> quando não houver terminal interativo")
    print("Modelos disponíveis no KeyProxy")
    print("  [validado] = testado no fluxo completo do Claude Code")
    print("  [gateway]  = anunciado, mas atualmente incompatível nesse fluxo")
    for index, model in enumerate(models, 1):
        status = "validado" if model in VALIDATED_MODELS else "gateway"
        default = ", padrão" if model == "gpt-5.6-sol" else ""
        print(f"  {index:2}. {model} [{status}{default}]")
    while True:
        answer = input("Selecione o número do modelo: ").strip()
        try:
            index = int(answer)
            if 1 <= index <= len(models):
                return models[index - 1]
        except ValueError:
            pass
        print("Seleção inválida.", file=sys.stderr)


def main():
    parser = argparse.ArgumentParser(description="Seleciona um modelo KeyProxy e inicia o Claude Code")
    parser.add_argument("--model", help="ID exato, sem abrir o menu")
    parser.add_argument("--list", action="store_true", help="lista modelos e sai")
    args, rest = parser.parse_known_args()

    config_dir = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude"))
    settings = read_settings(config_dir)
    env = settings.get("env") if isinstance(settings.get("env"), dict) else {}
    base_url = env.get("ANTHROPIC_BASE_URL")
    models_url = env.get("KEYPROXY_MODELS_URL", "https://painel.keyproxyhub.store/v1/models")
    token = os.environ.get("KEYPROXY_API_KEY") or env.get("KEYPROXY_API_KEY") or env.get("ANTHROPIC_AUTH_TOKEN")
    allowed_list = settings.get("availableModels")
    allowed = set(allowed_list if isinstance(allowed_list, list) else FALLBACK_MODELS)
    allowed &= set(FALLBACK_MODELS)
    cache = config_dir / "cache" / "keyproxy-models.json"

    if (
        base_url != "https://api.keyproxyhub.store/v1"
        or not isinstance(models_url, str)
        or not isinstance(token, str)
        or not token
    ):
        raise SystemExit("KeyProxy não está configurado. Execute o instalador primeiro.")

    try:
        models = discover(models_url, token, allowed)
        cache_write(cache, models)
    except (OSError, ValueError, urllib.error.URLError, json.JSONDecodeError) as exc:
        models = cache_read(cache, allowed)
        if not models:
            models = [model for model in FALLBACK_MODELS if model != "auto" and model in allowed]
        print(f"Aviso: descoberta indisponível ({type(exc).__name__}); usando lista local.", file=sys.stderr)

    if args.list:
        print("\n".join(models))
        return

    selected = args.model or choose(models)
    if selected not in models:
        raise SystemExit(f"Modelo não autorizado ou indisponível: {selected}")

    command = ["claude", "--model", selected]
    if rest and rest[0] == "--":
        rest = rest[1:]
    command.extend(rest)
    os.environ["KEYPROXY_API_KEY"] = token
    os.execvp(command[0], command)


if __name__ == "__main__":
    main()
